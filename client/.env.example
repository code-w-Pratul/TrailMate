# ===========================================================================
# TrailMate client configuration
# Copy to `client/.env` only if you need to override the defaults.
#
# Note what is NOT here: no API keys. The browser never talks to a third-party
# API, so there is nothing secret to leak into the bundle. Every `VITE_*`
# variable is compiled into public JavaScript — never put a secret in one.
# ===========================================================================

# Where the API lives.
# Leave EMPTY for the normal case: the Vite dev proxy and the production
# container both serve the API from the same origin under /api.
# Set it only for a split deployment (e.g. Vercel frontend + Render backend):
#   VITE_API_URL=https://trailmate-api.onrender.com/api
VITE_API_URL=

# Where the dev proxy forwards /api during `npm run dev`.
# Defaults to http://localhost:5000 — change it if the API runs on another port.
VITE_DEV_API_TARGET=http://localhost:5000
