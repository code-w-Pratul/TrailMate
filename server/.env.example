# ===========================================================================
# TrailMate API configuration
# Copy to `server/.env` and fill in what you need.
#
# IMPORTANT: every third-party API key below is OPTIONAL.
# TrailMate ships with a keyless fallback provider for each data source, so
# `npm run dev` works on a fresh clone with nothing but a Mongo connection.
# Adding a key simply upgrades that source to the richer provider.
# ===========================================================================

# --- Core -----------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Comma separated list of origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Database -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/trailmate

# --- Auth -----------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# --- Cache ----------------------------------------------------------------
# Leave REDIS_URL empty to use the built-in in-memory LRU cache instead.
REDIS_URL=
CACHE_TTL_WEATHER=1800        # seconds (30 min)
CACHE_TTL_PLACES=3600         # seconds (60 min)
CACHE_TTL_CURRENCY=1800       # seconds (30 min)
CACHE_TTL_COUNTRY=86400       # seconds (24 h — country data barely changes)
CACHE_TTL_PHOTO=86400         # seconds (24 h)
CACHE_TTL_GEOCODE=604800      # seconds (7 days)
CACHE_TTL_AI=3600             # seconds (60 min)

# How long a stale entry is retained past its TTL so it can be served as a
# fallback when the upstream API is down. Default 7 days.
CACHE_STALE_GRACE=604800

# --- Upstream resilience --------------------------------------------------
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRIES=1

# --- Rate limiting (protects *our* API) -----------------------------------
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=300            # requests per window per IP
AUTH_RATE_LIMIT_MAX=20        # login/register attempts per window per IP

# --- Optional API keys ----------------------------------------------------
# Weather: https://openweathermap.org/api  (1,000 calls/day free)
# Fallback when empty: Open-Meteo (no key, unlimited for fair use)
OPENWEATHER_API_KEY=

# Places: https://www.geoapify.com/  (3,000 credits/day free)
# Fallback when empty: OpenStreetMap Overpass API (no key)
GEOAPIFY_API_KEY=

# Photos: https://unsplash.com/developers  (50 requests/hour free)
# Fallback when empty: deterministic Picsum cover image (no key)
UNSPLASH_ACCESS_KEY=

# --- Optional AI provider -------------------------------------------------
# Provider order: groq -> gemini -> ollama -> rule-based template.
# The rule-based engine always works, so AI features never hard-fail.
AI_PROVIDER=auto              # auto | groq | gemini | ollama | rules

# https://console.groq.com/keys (generous free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama, e.g. http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# --- Daily free-tier budgets (used for the quota warning log) -------------
QUOTA_OPENWEATHER=1000
QUOTA_GEOAPIFY=3000
QUOTA_UNSPLASH=50
