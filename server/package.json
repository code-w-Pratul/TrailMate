{
  "name": "trailmate-server",
  "version": "1.0.0",
  "private": true,
  "description": "TrailMate API — proxy, normalisation, caching and persistence layer.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --watch",
    "test:coverage": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "axios": "1.19.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.2",
    "morgan": "1.11.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "cross-env": "10.1.0",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "jest": "30.4.2",
    "mongodb-memory-server": "11.2.0",
    "nock": "14.0.17",
    "supertest": "7.2.2"
  }
}
