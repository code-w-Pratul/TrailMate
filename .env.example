# ---------------------------------------------------------------------------
# Root .env — consumed by docker-compose only.
# Application config lives in server/.env and client/.env
# ---------------------------------------------------------------------------

# Port the API is published on from the container
SERVER_PORT=5000

# Port the client (nginx) is published on from the container
CLIENT_PORT=8080

# Mongo credentials used to bootstrap the containerised database
MONGO_INITDB_ROOT_USERNAME=trailmate
MONGO_INITDB_ROOT_PASSWORD=trailmate_dev_password

# Secret used to sign JWTs inside the container
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Optional API keys — every one of these is optional.
# TrailMate falls back to keyless providers when a key is absent.
OPENWEATHER_API_KEY=
GEOAPIFY_API_KEY=
UNSPLASH_ACCESS_KEY=
MAPBOX_TOKEN=
GROQ_API_KEY=
GEMINI_API_KEY=
